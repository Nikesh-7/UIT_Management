# Backend runtime
PORT=3000
NODE_ENV=development

# PostgreSQL connection string (keep credentials private)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/college_management?schema=public"

# Use a unique random secret with at least 32 characters
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# Comma-separated exact frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
